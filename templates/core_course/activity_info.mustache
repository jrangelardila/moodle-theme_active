{{!
    @template core_course/activity_info

    Activity information in theme_active: completion requirements first, in a card, then the description.
    Keeps the core regions and classes (the completion JavaScript uses them).

    Example context (json):
    {
        "activityname": "Final project",
        "hascompletion": true,
        "uservisible": true,
        "isautomatic": true,
        "description": "<p>Write a document…</p>",
        "description": "<p>Elabore un documento…</p>",
        "completiondetails": [
            {"statuscomplete": 1, "description": "View", "istrackeduser": true},
            {"statusincomplete": 1, "description": "Make a submission", "istrackeduser": true}
        ]
    }
}}
<div data-region="activity-information" data-activityname="{{activityname}}" class="activity-information tal-activity-info">
    <div data-region="activity-details" class="activity-details">
        {{#hascompletion}}
            {{#uservisible}}
                {{#isautomatic}}
                    <div class="completion-info tal-completion" data-region="completion-info">
                        <div class="automatic-completion-conditions" data-region="completionrequirements" role="region" aria-label="{{#str}}completionrequirements, core_course, {{activityname}}{{/str}}">
                            <div class="automatic-completion-title tal-completion-head">
                                <i class="fa fa-list-check" aria-hidden="true"></i>
                                <strong>{{#str}}completionrequirements, core_completion{{/str}}</strong>
                            </div>
                            <ul class="activity-completion-list tal-completion-list">
                                {{#completiondetails}}
                                    {{> core_course/completion_automatic }}
                                {{/completiondetails}}
                            </ul>
                        </div>
                    </div>
                {{/isautomatic}}
            {{/uservisible}}
        {{/hascompletion}}
        {{#description}}
            <div class="activity-description tal-activity-description" id="intro">
                {{{description}}}
            </div>
        {{/description}}
    </div>
</div>
