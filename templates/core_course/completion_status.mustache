{{!
    @template core_course/completion_status

    Estado de finalización de la actividad en el encabezado, como píldora con fondo propio:
    "Completado" (verde) o "Pendiente por completar" (ámbar). El núcleo solo muestra el primero.

    Example context (json):
    {
        "istrackeduser": true,
        "overallcomplete": true,
        "overallincomplete": false
    }
}}
{{#istrackeduser}}
    {{#overallcomplete}}
        <span class="completion-status tal-completion tal-completion--done">
            <i class="fa fa-check" aria-hidden="true"></i> <span>{{#str}} done, core_completion {{/str}}</span>
        </span>
    {{/overallcomplete}}
    {{#overallincomplete}}
        <span class="completion-status tal-completion tal-completion--pending">
            <i class="fa fa-hourglass-half" aria-hidden="true"></i> <span>{{#str}} completionpending, theme_active {{/str}}</span>
        </span>
    {{/overallincomplete}}
{{/istrackeduser}}
