{{!
    @template theme_boost/footer

    Page footer — overridden by theme_active.

    Example context (json):
    {
        "output": {},
        "sitename": "My LMS",
        "sitefullname": "My Learning Platform",
        "hassocial": true,
        "sociallinks": [{"url": "#", "icon": "fa-facebook-f", "color": "#1877F2", "name": "Facebook"}],
        "hasapps": true,
        "apps": [{"url": "#", "icon": "fa-google-play", "label": "Google Play"}],
        "infolinks": [{"url": "/", "icon": "fa-house", "label": "Home"}],
        "currentyear": "2026"
    }
}}

<div class="theme-active-footer" id="page-footer">
    <div class="container taf-inner">

        <div class="row">

            <div class="col-lg-4 col-md-12 taf-brand-col" data-taf-reveal>
                <h4 class="taf-site-name">{{{ sitefullname }}}</h4>
                {{#hassummary}}
                <p class="taf-site-desc">{{{ sitesummary }}}</p>
                {{/hassummary}}
                {{#hassocial}}
                <div class="taf-social">
                    {{#sociallinks}}
                    <a href="{{ url }}"
                       target="_blank"
                       rel="noopener"
                       class="taf-social-link"
                       title="{{{ name }}}"
                       style="--taf-brand:{{ color }}">
                        <i class="fa-brands {{ icon }}"></i>
                    </a>
                    {{/sociallinks}}
                </div>
                {{/hassocial}}
            </div>

            <div class="col-lg-4 col-sm-6 taf-links-col" data-taf-reveal>
                <h6 class="taf-heading">{{{ lbl_info }}}</h6>
                <ul class="taf-link-list">
                    {{#infolinks}}
                    <li>
                        <a href="{{ url }}">
                            <i class="fa-solid {{ icon }}"></i>
                            <span>{{{ label }}}</span>
                        </a>
                    </li>
                    {{/infolinks}}
                </ul>
            </div>
            {{#hasapps}}
            <div class="col-lg-4 col-sm-6 taf-links-col" data-taf-reveal>
                <h6 class="taf-heading">{{{ lbl_apps }}}</h6>
                <div class="taf-apps">
                    {{#apps}}
                    <a href="{{ url }}" target="_blank" rel="noopener" class="taf-app-btn">
                        <i class="fa-brands {{ icon }}"></i>
                        <div class="taf-app-text">
                            <small>{{#str}} downloadapp, theme_active {{/str}}</small>
                            <strong>{{{ label }}}</strong>
                        </div>
                    </a>
                    {{/apps}}
                </div>
            </div>
            {{/hasapps}}

        </div>
        <div class="taf-divider"></div>

        <div class="taf-bottom">
            <span>&copy; {{ currentyear }} {{{ sitefullname }}}. {{#str}} poweredbymoodle, core {{/str}}</span>
        </div>

    </div>

    {{{ output.standard_end_of_body_html }}}
    {{{ output.debug_footer_html }}}
</div>

{{#js}}
require(['theme_boost/footer-popover'], function(FooterPopover) {
    FooterPopover.init();
});
require(['theme_active/footer'], function(Footer) {
    Footer.init();
});
{{/js}}
