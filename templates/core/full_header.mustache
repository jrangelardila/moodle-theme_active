{{!
    @template core/full_header
    theme_active — Redesigned page header with breadcrumbs.
}}
<header id="page-header" class="tal-header d-print-none">
    <div class="tal-header-banner {{#courseimageurl}}tal-header-banner--hasimage{{/courseimageurl}}"
         {{#courseimageurl}}style="background-image: url('{{courseimageurl}}');"{{/courseimageurl}}>
        <div class="tal-header-banner-inner">
            <div class="tal-header-title-area">
                <div class="tal-header-icon-accent">
                    <i class="fa fa-layer-group"></i>
                </div>
                <div class="tal-header-content">
                    {{#welcomemessage}}
                        <div class="tal-welcome">
                            {{{welcomemessage}}}
                        </div>
                    {{/welcomemessage}}
                    {{^welcomemessage}}
                        {{#contextheader}}
                            <div class="tal-context-header">
                                {{{contextheader}}}
                            </div>
                        {{/contextheader}}
                    {{/welcomemessage}}
                </div>
            </div>

            {{#hasheaderteachers}}
                <div class="tal-header-teachers">
                    {{#headerteachers}}
                        <a href="{{profileurl}}" class="tal-header-teacher-link" title="{{{fullname}}}">
                            <img src="{{avatarurl}}" alt="{{{fullname}}}" class="tal-header-teacher-avatar">
                        </a>
                    {{/headerteachers}}
                </div>
            {{/hasheaderteachers}}

            <div class="tal-header-actions">
                {{#headeractions}}
                    <div class="tal-header-action">{{{.}}}</div>
                {{/headeractions}}
                {{{pageheadingbutton}}}
            </div>
        </div>

        {{#courseheader}}
            <div class="tal-course-header">
                {{{courseheader}}}
            </div>
        {{/courseheader}}
    </div>
    <div id="tal-breadcrumb-wrapper" class="tal-breadcrumb-wrapper" style="display:none;">
        <div class="tal-breadcrumb-bar">
            <div class="tal-breadcrumb-inner">
                <nav id="page-navbar" class="tal-breadcrumb-nav">
                    {{#navbar}}
                        {{{ navbar }}}
                    {{/navbar}}
                </nav>
            </div>
        </div>
    </div>
    {{#js}}
        (function() {
            var w = document.getElementById('tal-breadcrumb-wrapper');
            if (w && w.querySelector('.breadcrumb-item')) {
                w.style.display = '';
            }
        })();
    {{/js}}

    {{#hasquicklinks}}
    <div class="tal-quicklinks-section">
        <div class="tal-quicklinks-bar">
            {{#quicklinks}}
                <a href="{{url}}" target="{{target}}" rel="noopener" class="tal-quicklink">
                    <span class="tal-quicklink-icon">
                        <i class="fa fa-{{icon}}" aria-hidden="true"></i>
                    </span>
                    <span class="tal-quicklink-label">{{label}}</span>
                </a>
            {{/quicklinks}}
        </div>
    </div>
    {{/hasquicklinks}}

</header>
