{{!
    @template theme_active/forum_discussion_nav

    Premium discussion navigation — previous/next with discussion info.

    Context variables:
    * hasprev - boolean
    * hasnext - boolean
    * prev.url, prev.name
    * next.url, next.name
    * hasforumlink - boolean
    * forumurl - string
    * forumname - string

    @package theme_active
}}
<nav class="tal-forum-nav d-print-none" aria-label="{{#str}}forumnav_aria, theme_active{{/str}}">
    <div class="tal-forum-nav-inner">
        <div class="tal-forum-nav-side tal-forum-nav-prev">
            {{#hasprev}}
            <a href="{{prev.url}}" class="tal-forum-nav-btn tal-forum-nav-btn--prev" title="{{prev.name}}">
                <span class="tal-forum-nav-arrow">
                    <i class="fa fa-chevron-left"></i>
                </span>
                <span class="tal-forum-nav-info">
                    <span class="tal-forum-nav-direction">{{#str}}forumnav_prev, theme_active{{/str}}</span>
                    <span class="tal-forum-nav-name">{{{prev.name}}}</span>
                </span>
            </a>
            {{/hasprev}}
        </div>
        <div class="tal-forum-nav-center">
            {{#hasforumlink}}
            <a href="{{forumurl}}" class="tal-forum-nav-back" title="{{forumname}}">
                <i class="fa fa-comments"></i>
                <span class="tal-forum-nav-back-text">{{{forumname}}}</span>
            </a>
            {{/hasforumlink}}
        </div>
        <div class="tal-forum-nav-side tal-forum-nav-next">
            {{#hasnext}}
            <a href="{{next.url}}" class="tal-forum-nav-btn tal-forum-nav-btn--next" title="{{next.name}}">
                <span class="tal-forum-nav-info tal-forum-nav-info--right">
                    <span class="tal-forum-nav-direction">{{#str}}forumnav_next, theme_active{{/str}}</span>
                    <span class="tal-forum-nav-name">{{{next.name}}}</span>
                </span>
                <span class="tal-forum-nav-arrow">
                    <i class="fa fa-chevron-right"></i>
                </span>
            </a>
            {{/hasnext}}
        </div>
    </div>
</nav>
