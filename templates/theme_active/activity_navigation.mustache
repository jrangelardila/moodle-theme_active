{{!
    @template theme_active/activity_navigation

    Premium activity navigation — next/previous with activity info.

    Context variables:
    * hasprev - boolean
    * hasnext - boolean
    * prev.url, prev.name, prev.iconurl, prev.modname
    * next.url, next.name, next.iconurl, next.modname
    * position - current activity number
    * total - total activities
}}
<nav class="tal-activity-nav d-print-none" aria-label="{{#str}}activitynavigation, core_course{{/str}}">
    <div class="tal-activity-nav-inner">
        <div class="tal-activity-nav-side tal-activity-nav-prev">
            {{#hasprev}}
            <a href="{{prev.url}}" class="tal-nav-btn tal-nav-btn--prev" title="{{prev.name}}">
                <span class="tal-nav-arrow">
                    <i class="fa fa-chevron-left"></i>
                </span>
                <span class="tal-nav-info">
                    <span class="tal-nav-direction">{{#str}}previous{{/str}}</span>
                    <span class="tal-nav-name">
                        <img src="{{prev.iconurl}}" alt="" class="tal-nav-modicon" width="18" height="18">
                        {{{prev.name}}}
                    </span>
                    <span class="tal-nav-modtype">{{{prev.modname}}}</span>
                </span>
            </a>
            {{/hasprev}}
        </div>
        <div class="tal-activity-nav-center">
            <span class="tal-nav-position">{{position}} / {{total}}</span>
        </div>
        <div class="tal-activity-nav-side tal-activity-nav-next">
            {{#hasnext}}
            <a href="{{next.url}}" class="tal-nav-btn tal-nav-btn--next" title="{{next.name}}">
                <span class="tal-nav-info tal-nav-info--right">
                    <span class="tal-nav-direction">{{#str}}next{{/str}}</span>
                    <span class="tal-nav-name">
                        <img src="{{next.iconurl}}" alt="" class="tal-nav-modicon" width="18" height="18">
                        {{{next.name}}}
                    </span>
                    <span class="tal-nav-modtype">{{{next.modname}}}</span>
                </span>
                <span class="tal-nav-arrow">
                    <i class="fa fa-chevron-right"></i>
                </span>
            </a>
            {{/hasnext}}
        </div>

    </div>
</nav>
