{{!
    @template theme_active/card_progress

    Completion progress strip shown inside a course card for the current user.

    Context variables required for this template:
    * percent - int 0-100
    * iscomplete - boolean
    * progressof - string, e.g. "3 de 10 actividades completadas"

    Example context (json):
    {
        "percent": 65,
        "iscomplete": false,
        "progressof": "13 de 20 actividades completadas"
    }
}}
<div class="tal-card-progress mt-auto pt-2">
    <div class="d-flex justify-content-between align-items-center small mb-1">
        {{#iscomplete}}
            <span class="badge bg-success tal-card-progress-done">
                <i class="fa fa-circle-check me-1" aria-hidden="true"></i>{{#str}}cardprogress_complete, theme_active{{/str}}
            </span>
        {{/iscomplete}}
        {{^iscomplete}}
            <span class="text-muted tal-card-progress-label">{{progressof}}</span>
        {{/iscomplete}}
        <span class="fw-bold tal-card-progress-percent">{{percent}}%</span>
    </div>
    <div class="progress tal-card-progress-track"
         role="progressbar"
         aria-valuenow="{{percent}}"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-label="{{#str}}cardprogress, theme_active{{/str}}: {{percent}}%">
        <div class="progress-bar {{#iscomplete}}bg-success{{/iscomplete}}" style="width: {{percent}}%"></div>
    </div>
</div>
