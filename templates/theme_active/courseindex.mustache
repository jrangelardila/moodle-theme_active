{{!
    @template theme_active/courseindex

    Premium course index — timeline + nodes + cards.
    Inspired by Platzi, Coursera, Linear, Duolingo.

    @package   theme_active
    @copyright 2026 Jhon Rangel <jrangelardila@gmail.com>
    @license   https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<nav id="tal-courseindex" class="tal-ci" data-courseid="{{courseid}}">
    {{#hasactive}}
    <div class="tal-ci-qnav">
        {{#hasprev}}
        <a href="{{prev.url}}" class="tal-ci-qnav-btn" title="{{prev.name}}">
            <svg width="14" height="14" viewBox="0 0 16 16"><path d="M8 13V3M3 8l5-5 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="tal-ci-qnav-text">{{{prev.name}}}</span>
        </a>
        {{/hasprev}}
        {{^hasprev}}<span class="tal-ci-qnav-btn is-off"><svg width="14" height="14" viewBox="0 0 16 16"><path d="M8 13V3M3 8l5-5 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{{/hasprev}}

        {{#hasnext}}
        <a href="{{next.url}}" class="tal-ci-qnav-btn" title="{{next.name}}">
            <svg width="14" height="14" viewBox="0 0 16 16"><path d="M8 3v10M3 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="tal-ci-qnav-text">{{{next.name}}}</span>
        </a>
        {{/hasnext}}
        {{^hasnext}}<span class="tal-ci-qnav-btn is-off"><svg width="14" height="14" viewBox="0 0 16 16"><path d="M8 3v10M3 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{{/hasnext}}
    </div>
    {{/hasactive}}

    {{#hassections}}
    <div class="tal-ci-scroll">
        {{#sections}}

        <div class="tal-ci-sec {{#current}}is-cur{{/current}} {{#expanded}}is-open{{/expanded}}" data-sec="{{number}}">

            <a class="tal-ci-sec-hd {{^expanded}}collapsed{{/expanded}}"
               data-bs-toggle="collapse" data-bs-target="#tal-s{{number}}"
               role="button"
               aria-expanded="{{#expanded}}true{{/expanded}}{{^expanded}}false{{/expanded}}">

                <span class="tal-ci-sec-node">
                    {{#hassectionprogress}}
                    <svg class="tal-ci-ring" viewBox="0 0 36 36" width="26" height="26">
                        <circle cx="18" cy="18" r="15" fill="none" stroke="#e5e7eb" stroke-width="2.5"/>
                        <circle cx="18" cy="18" r="15" fill="none" stroke-width="2.5"
                                stroke-dasharray="{{sectionpercent}} {{sectionremaining}}"
                                stroke-dashoffset="25" stroke-linecap="round"
                                class="tal-ci-ring-v"/>
                    </svg>
                    <span class="tal-ci-ring-pct">{{sectionpercent}}</span>
                    {{/hassectionprogress}}
                    {{^hassectionprogress}}
                    <span class="tal-ci-sec-dot"></span>
                    {{/hassectionprogress}}
                </span>

                <span class="tal-ci-sec-lbl">
                    <span class="tal-ci-sec-name">{{{title}}}</span>
                    {{#hassectionprogress}}
                    <span class="tal-ci-sec-meta">{{{sectionprogresslabel}}} {{#str}}completed, completion{{/str}}</span>
                    {{/hassectionprogress}}
                </span>

                <svg class="tal-ci-sec-arr" width="16" height="16" viewBox="0 0 16 16">
                    <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>

            {{#hascms}}
            <div id="tal-s{{number}}" class="collapse {{#expanded}}show{{/expanded}}">
                <div class="tal-ci-timeline">
                    {{#cms}}
                    <div class="tal-ci-tm-item {{#isactive}}is-active{{/isactive}} {{#iscomplete}}is-done{{/iscomplete}} {{#isfail}}is-fail{{/isfail}} {{^accessvisible}}is-dim{{/accessvisible}} {{#hascmrestrictions}}is-lock{{/hascmrestrictions}}" data-cmid="{{id}}">

                        <span class="tal-ci-tm-node">
                            {{#iscomplete}}
                            <svg class="tal-ci-check" viewBox="0 0 20 20" width="20" height="20">
                                <circle cx="10" cy="10" r="10" class="tal-ci-check-bg"/>
                                <path d="M6 10.5l2.5 2.5 5.5-5.5" class="tal-ci-check-mark" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            {{/iscomplete}}
                            {{#isfail}}
                            <svg viewBox="0 0 20 20" width="20" height="20">
                                <circle cx="10" cy="10" r="10" fill="#fee2e2"/>
                                <path d="M7 7l6 6M13 7l-6 6" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                            {{/isfail}}
                            {{#isincomplete}}
                            <span class="tal-ci-tm-dot"></span>
                            {{/isincomplete}}
                            {{^hascompletion}}
                            <img class="tal-ci-tm-icon" src="{{iconurl}}" alt=""/>
                            {{/hascompletion}}
                        </span>

                        <a href="{{url}}" class="tal-ci-tm-card">
                            <span class="tal-ci-tm-name">{{{name}}}</span>
                            {{#hascmrestrictions}}
                            <svg class="tal-ci-tm-lock" width="11" height="11" viewBox="0 0 16 16"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M5.5 7V5a2.5 2.5 0 015 0v2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                            {{/hascmrestrictions}}
                        </a>
                    </div>
                    {{/cms}}
                </div>
            </div>
            {{/hascms}}
        </div>
        {{/sections}}
    </div>
    {{/hassections}}
</nav>
